/* Windows 资源：程序图标与版本信息（保持 ASCII 以免 windres 编码问题） */
#include <windows.h>

/* 应用程序图标（标题栏 / 任务栏 / 资源管理器）
 * 必须用数值 ID：windres 才会同时生成 RT_ICON 与 RT_GROUP_ICON，
 * 资源管理器才能显示 exe 图标。 */
#define IDI_APP_ICON 101
IDI_APP_ICON ICON DISCARDABLE "../resources/icons/logo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "WeAct Studio"
            VALUE "FileDescription", "CH32H417 Logic Analyzer Firmware Upgrade Tool"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "CH32H417 Logic Analyzer Upgrade"
            VALUE "LegalCopyright", "Copyright (C) 2026 WeAct Studio"
            VALUE "OriginalFilename", "CH32H417 Logic Analyzer Upgrade.exe"
            VALUE "ProductName", "CH32H417 Logic Analyzer Upgrade"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
